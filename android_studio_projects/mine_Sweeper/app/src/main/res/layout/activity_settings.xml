<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_minesweeper">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mine Sweeper Settings"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="409dp"
        android:layout_height="80dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="480dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowlabel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Row Count"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Column Count"
                android:textAlignment="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/seekrows"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="10"
                android:min="5"
                android:progress="5" />

            <SeekBar
                android:id="@+id/seekcols"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="10"
                android:min="5"
                android:progress="5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/rowCount"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:ems="10"
                android:inputType="number" />

            <EditText
                android:id="@+id/colCount"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:ems="10"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/minePercentage"
        android:layout_width="179dp"
        android:layout_height="47dp"
        android:checkedButton="@id/p10"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.711"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.319">

        <RadioButton
            android:id="@+id/p10"
            android:tag="10"
            android:text="10%"
            android:layout_height="46dp"
            android:layout_width="60dp" />

        <RadioButton
            android:id="@+id/p15"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:tag="15"
            android:text="15%" />

        <RadioButton
            android:id="@+id/p20"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:tag="20"
            android:text="20%" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="409dp"
        android:layout_height="300dp"
        android:layout_marginTop="300dp"
        android:layout_marginBottom="75dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="102dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Covered Cell" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/colorGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRed"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red"
                    android:textColor="#FF3B30"
                    android:tag="#FF3B30"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#FF3B30"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBlue"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blue"
                    android:textColor="#007AFF"
                    android:tag="#007AFF"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#007AFF"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGreen"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Green"
                    android:textColor="#34C759"
                    android:tag="#34C759"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#34C759"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipYellow"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yellow"
                    android:textColor="#FFCC00"
                    android:tag="#FFCC00"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#FFCC00"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPurple"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purple"
                    android:textColor="#AF52DE"
                    android:tag="#AF52DE"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#AF52DE"
                    app:chipStrokeWidth="2dp" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="102dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uncovered Cell" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/colorGroup2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCyan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cyan"
                    android:textColor="#00BCD4"
                    android:tag="#00BCD4"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#00BCD4"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOrange"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orange"
                    android:textColor="#FF9500"
                    android:tag="#FF9500"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#FF9500"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPink"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pink"
                    android:textColor="#FF2D55"
                    android:tag="#FF2D55"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#FF2D55"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTeal"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teal"
                    android:textColor="#4CD1B7"
                    android:tag="#4CD1B7"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#4CD1B7"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGray"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gray"
                    android:textColor="#8E8E93"
                    android:tag="#8E8E93"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#8E8E93"
                    app:chipStrokeWidth="2dp" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="102dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flag" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/colorGroup3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrown"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brown"
                    android:textColor="#A0522D"
                    android:tag="#A0522D"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#A0522D"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLime"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lime"
                    android:textColor="#C7EA46"
                    android:tag="#C7EA46"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#C7EA46"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNavy"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Navy"
                    android:textColor="#001F54"
                    android:tag="#001F54"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#001F54"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCoral"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coral"
                    android:textColor="#FF6F61"
                    android:tag="#FF6F61"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#FF6F61"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGold"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gold"
                    android:textColor="#D4AF37"
                    android:tag="#D4AF37"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#D4AF37"
                    app:chipStrokeWidth="2dp" />


            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="102dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mine" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/colorGroup4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSlate"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slate"
                    android:textColor="#708090"
                    android:tag="#708090"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#708090"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBurgundy"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Burgundy"
                    android:textColor="#800020"
                    android:tag="#800020"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#800020"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSky"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sky"
                    android:textColor="#87CEEB"
                    android:tag="#87CEEB"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#87CEEB"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSand"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sand"
                    android:textColor="#D2B48C"
                    android:tag="#D2B48C"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#D2B48C"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOlive"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olive"
                    android:textColor="#808000"
                    android:tag="#808000"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#808000"
                    app:chipStrokeWidth="2dp" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Color Selection"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/minePercentage"
        app:layout_constraintVertical_bias="0.875" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mine Percentage"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toStartOf="@+id/minePercentage"
        app:layout_constraintHorizontal_bias="0.677"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintVertical_bias="0.454" />

    <Button
        android:id="@+id/save_exit"
        android:layout_width="147dp"
        android:layout_height="53dp"
        android:backgroundTint="#878787"
        android:text="Save and Exit"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.96" />

</androidx.constraintlayout.widget.ConstraintLayout>